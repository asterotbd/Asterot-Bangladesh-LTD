# Copy this file to .env.local and fill in production credentials (do NOT commit real secrets).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# For type generation using Supabase CLI
SUPABASE_PROJECT_REF=

# YouTube → website video synchronization (server-side only)
YOUTUBE_API_KEY=            # YouTube Data API v3 key (leave empty to use the public RSS fallback)
YOUTUBE_CHANNEL_ID=         # Asterot channel ID, defaults to UCGuIVgrGUhcZyB13wQpVK8A
CRON_SECRET=                # Bearer token that protects /api/cron/youtube-sync
