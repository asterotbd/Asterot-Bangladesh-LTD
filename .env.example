# =============================================================================
# Asterot website — environment template
# Copy to .env.local and fill in real values. NEVER commit .env.local or real secrets.
# =============================================================================

# --- Supabase (required) -----------------------------------------------------

# Project URL: Supabase Dashboard -> Settings -> API -> Project URL
# Safe for the browser (public). Example: https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable ("anon") key: Supabase Dashboard -> Settings -> API -> anon public key
# Safe for the browser; row access is restricted by RLS policies.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Service-role key: Supabase Dashboard -> Settings -> API -> service_role secret
# SERVER-ONLY. Bypasses RLS — used by admin API routes and the cron sync.
# Never expose this in client code or commit it anywhere.
SUPABASE_SERVICE_ROLE_KEY=

# --- Cloudflare R2 (required for media storage) ------------------------------

# Cloudflare Account ID
R2_ACCOUNT_ID=

# Cloudflare R2 Access Key ID (server-side only)
R2_ACCESS_KEY_ID=

# Cloudflare R2 Secret Access Key (server-side only)
# Never expose this in client code or NEXT_PUBLIC_* variables.
R2_SECRET_ACCESS_KEY=

# Cloudflare R2 Bucket Name
# Existing bucket: jihan-project
R2_BUCKET=jihan-project

# Cloudflare R2 S3 Endpoint
R2_S3_ENDPOINT=

# Cloudflare R2 Public URL (public, safe for browser)
NEXT_PUBLIC_R2_PUBLIC_URL=https://pub-67c6d567950d419f9f3429a1cc66dfb3.r2.dev

# --- YouTube sync (optional) --------------------------------------------------

# YouTube Data API v3 key used by /api/cron/youtube-sync (server-side only).
# Leave empty to fall back to the public RSS feed.
YOUTUBE_API_KEY=

# --- AI guide (server-side only) ---------------------------------------------

# Gemini API key used by /api/ai/guide (server-side only).
# Never expose it in client code or NEXT_PUBLIC_* variables.
GEMINI_API_KEY=

# Asterot YouTube channel ID. Defaults to UCGuIVgrGUhcZyB13wQpVK8A when empty.
YOUTUBE_CHANNEL_ID=

# Bearer token that protects /api/cron/youtube-sync from unauthorized calls.
# Must match the CRON_SECRET configured on Vercel / GitHub Actions secrets.
CRON_SECRET=

# --- Supabase CLI type generation (optional, not used at runtime) -------------

# Supabase project ref, used only when generating TypeScript types:
# supabase gen types typescript --project-ref $SUPABASE_PROJECT_REF --schema public > types/supabase.ts
SUPABASE_PROJECT_REF=
